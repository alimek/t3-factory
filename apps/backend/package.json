{
  "name": "@t3-factory/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "factory-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "factory-source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./server": {
      "factory-source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vp test run",
    "schema:update": "vp test run test/schema-snapshot.test.ts -u",
    "start": "node dist/main.js",
    "dev": "vpx --watch --clear-screen=false --no-rerun-on-enter --include \"src/migrations/**/*.sql\" --include \"../../packages/*/src/**/*.ts\" --conditions=factory-source ../../scripts/dev/server.ts",
    "dev:prod": "vpx --watch --clear-screen=false --no-rerun-on-enter --include \"src/migrations/**/*.sql\" --include \"../../packages/*/src/**/*.ts\" --conditions=factory-source src/main.ts --api-only"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/sql-sqlite-node": "4.1.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@t3-factory/contracts": "workspace:*",
    "@t3-factory/domain-validation": "workspace:*",
    "@t3-factory/flow-layout": "workspace:*",
    "effect": "4.1.2",
    "fs-ext": "2.1.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/fs-ext": "2.0.3",
    "@types/ws": "8.18.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "ws": "8.22.1"
  }
}
