{
  "name": "t3-factory",
  "version": "0.10.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "typecheck:root": "tsc -p tsconfig.json",
    "typecheck": "vp run --concurrency-limit 8 gate:typecheck",
    "test": "vp run --filter @t3-factory/backend --filter @t3-factory/desktop --filter @t3-factory/frontend test && vp run test:scripts",
    "test:scripts": "node --conditions=factory-source --test scripts/*.test.mjs scripts/dev/scenario-catalog.test.ts",
    "start": "pnpm --filter @t3-factory/backend start",
    "dev": "node scripts/dev.mjs",
    "dev:prod": "node scripts/dev.mjs --production-data",
    "scenarios:catalog": "node --conditions=factory-source scripts/dev/scenario-catalog.ts",
    "check:scenarios": "node --conditions=factory-source scripts/dev/scenario-catalog.ts --check",
    "db:reset": "node --conditions=factory-source scripts/dev/server.ts --reset",
    "e2e:prepare": "node scripts/ui-build.ts || vp run --filter @t3-factory/frontend... build",
    "test:e2e": "pnpm e2e:prepare && e2e run",
    "test:e2e:affected": "node scripts/select-ui-journeys.mjs --affected --run",
    "desktop:package": "pnpm build && pnpm --filter @t3-factory/desktop package",
    "desktop:package:release": "pnpm build && pnpm --filter @t3-factory/desktop package --release",
    "desktop:package:beta": "pnpm build && pnpm --filter @t3-factory/desktop package --beta",
    "desktop:probe": "node apps/desktop/scripts/probe-package.mjs",
    "e2e:screenshots": "pnpm e2e:prepare && e2e run tests/screenshots.e2e.ts --trace on --output .e2e/screenshots",
    "e2e:evidence": "node scripts/e2e-evidence.mjs",
    "e2e:evidence-diff": "node scripts/ui-evidence-diff.mjs",
    "e2e:explore": "e2e explore --config e2e.explore.config.ts",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp run lint:workspace",
    "fallow:dead-code": "fallow dead-code --fail-on-issues --quiet --no-cache",
    "fallow:dupes": "fallow dupes --fail-on-issues --quiet --no-cache",
    "fallow:complexity": "fallow health --complexity --fail-on-issues --quiet --no-cache",
    "fallow": "vp run --concurrency-limit 8 gate:fallow",
    "check:e2e-configs": "node scripts/check-e2e-configs.mjs",
    "check:git-attribution": "node scripts/check-git-attribution.mjs",
    "check:ui-evidence": "node scripts/check-ui-evidence.mjs",
    "prepare": "vp config --no-agent",
    "check:static": "vp run --concurrency-limit 8 gate:static",
    "check": "vp run --concurrency-limit 8 gate:check"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.15.4",
    "@types/node": "24.10.1",
    "concurrently": "10.0.6",
    "e2e": "0.22.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fallow": "3.38.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}
