{
  "name": "@t3-factory/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "factory-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./live-rpc": {
      "factory-source": "./src/live-rpc.ts",
      "types": "./dist/live-rpc.d.ts",
      "default": "./dist/live-rpc.js"
    },
    "./desktop-bridge": {
      "factory-source": "./src/desktop-bridge.ts",
      "types": "./dist/desktop-bridge.d.ts",
      "default": "./dist/desktop-bridge.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect": "4.1.2"
  }
}
