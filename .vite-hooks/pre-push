#!/usr/bin/env sh
# Quality gate run before every push. See docs/quality-gates.md.
# Never bypass it with --no-verify; fix the failure instead.
set -eu

# Git exports repository variables (GIT_DIR, GIT_INDEX_FILE, ...) to hooks. Tests spawn
# git and the backend inspects repositories, so clear them to keep checks hermetic.
for var in $(git rev-parse --local-env-vars); do unset "$var"; done

pnpm check
